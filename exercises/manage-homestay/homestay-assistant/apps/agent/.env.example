MASTRA_PLATFORM_ACCESS_TOKEN=sk_
MASTRA_PROJECT_ID=
OPENAI_API_KEY=your-api-key
# Only needed when AI_PROVIDER=cerebras (dev token-limit testing).
CEREBRAS_API_KEY=
# Only needed when AI_PROVIDER=openrouter. One key fronts many upstream models.
OPENROUTER_API_KEY=
API_URL=
OPENAI_TRACING=
# Chat model switch: `openai` (default), `cerebras`, or `openrouter`.
AI_PROVIDER=openai
# Optional per-provider slug overrides.
# OPENAI_MODEL=openai/gpt-4o-mini
# CEREBRAS_MODEL=cerebras/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/openai/gpt-4o-mini
# Optional hard override — explicit `provider/model` router id, wins over AI_PROVIDER.
AI_MODEL=
# Prompt-injection detector model. Defaults to openai/gpt-4o-mini, or
# openrouter/openai/gpt-4o-mini when AI_PROVIDER=openrouter.
AI_SECURITY_MODEL=
# Set to 1 to log each step's OpenAI prompt-cache hit rate to the console
# (see prompt-cache-usage.ts). No-op on non-OpenAI providers. NOTE: the agent
# runs in-process inside apps/web, so set this in apps/web/.env to affect the
# running app — this file only affects standalone `mastra dev`.
LOG_PROMPT_CACHE=
