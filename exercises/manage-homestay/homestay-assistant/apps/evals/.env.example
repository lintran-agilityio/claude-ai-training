# Loaded via `node --env-file-if-exists=.env` by the eval:* scripts.
# A missing file is fine — CI injects these as real environment variables.

# Chat model switch, same resolution as production (apps/agent's
# constants/model.ts): `openai` (default) | `cerebras` | `openrouter` |
# `mistral`. The deployed Evalite dashboard runs on `mistral`.
AI_PROVIDER=mistral

# --- Provider key: set the one that matches AI_PROVIDER ---
# `mistral`  → https://console.mistral.ai/api-keys (free "Experiment" tier is
#              enough; needs phone verification). @mastra/core bundles the
#              Mistral provider, so no extra @ai-sdk/* package is required.
MISTRAL_API_KEY=your-api-key
# `openai`   → required for the tools/ + conversation/ suites on the OpenAI path
#              (agent model calls + the LLM judge).
OPENAI_API_KEY=
# `cerebras` / `openrouter`
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional per-provider slug override (defaults: openai/gpt-4o-mini,
# cerebras/gpt-oss-120b, openrouter/openai/gpt-4o-mini,
# mistral/mistral-small-latest).
MISTRAL_MODEL=
# Optional hard override — explicit `provider/model` router id, wins over all.
AI_MODEL=
# Prompt-injection detector model. Auto-resolves to a Mistral model when
# AI_PROVIDER=mistral and no OpenAI/OpenRouter key is set; override here to pin.
AI_SECURITY_MODEL=

# Only parsed to a valid URL — the fixture fetch stub intercepts this origin,
# so no live apps/api process is contacted. Any non-real host works.
API_URL=https://evalite-fixture.invalid

# Trailing-60s token budget the run paces itself to so a fresh `eval:serve`
# never bursts past the provider's TPM cap (src/support/
# model-rate-limit.setup.ts). Set 0 to disable token pacing. Default 150000.
EVAL_TPM_BUDGET=150000

# Minimum gap between consecutive provider requests, in ms. Mistral's free tier
# caps at ~1 request/second and one agent turn fires several sequential calls,
# so keep this at ~1100 on the Mistral path. 0 = off (fine for OpenAI).
EVAL_MIN_REQUEST_INTERVAL_MS=1100

# Where the rate-limiter's cross-fork token ledger / request-spacing marker and
# any ephemeral Mastra storage go. Keep it off the source tree.
MASTRA_DATA_DIR=/tmp/mastra-evalite
