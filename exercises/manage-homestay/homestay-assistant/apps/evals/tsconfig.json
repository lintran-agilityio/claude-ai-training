{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@agent/*": ["../agent/src/*"],
      "@/mastra/*": ["../agent/src/mastra/*"]
    }
  },
  "include": ["src/**/*", "evalite.config.ts", "vitest.config.ts"]
}
