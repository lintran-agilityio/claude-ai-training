FROM node:22-alpine

WORKDIR /repo

RUN corepack enable

COPY package.json .
COPY pnpm-lock.yaml .
COPY pnpm-workspace.yaml .
COPY turbo.json .
# pnpm-workspace.yaml `patchedDependencies` — install fails without these.
COPY patches ./patches

COPY apps ./apps
COPY packages ./packages

RUN pnpm install --frozen-lockfile

RUN pnpm turbo run build --filter=agent

WORKDIR /repo/apps/agent

EXPOSE 4111

CMD ["pnpm","start"]
