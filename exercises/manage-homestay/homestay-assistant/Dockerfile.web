FROM node:22-alpine

WORKDIR /repo

RUN corepack enable

COPY package.json .
COPY pnpm-lock.yaml .
COPY pnpm-workspace.yaml .
COPY turbo.json .
# pnpm-workspace.yaml `patchedDependencies` — install fails without these.
COPY patches ./patches

COPY apps ./apps
COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm turbo run build

EXPOSE 3000

CMD ["pnpm", "--filter", "web", "start"]